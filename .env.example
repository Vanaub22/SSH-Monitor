# The demo source is safe and requires no access to system logs.
SSH_MONITOR_SOURCE=demo

# File mode mounts this host file into the container.
SSH_MONITOR_LOG_PATH=./data/ssh.log

# The dashboard is available on this host port.
SSH_MONITOR_PUBLIC_PORT=8080

# A warning appears at this many failures inside the rolling window.
SSH_MONITOR_ALERT_THRESHOLD=10
SSH_MONITOR_WINDOW_SECONDS=60

# Set this to true to ignore lines that existed before startup.
SSH_MONITOR_IGNORE_EXISTING=false
